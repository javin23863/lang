{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spoken-translation-room",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "assets": {
    "directory": "../windows/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "ABUSE", "class_name": "AbuseGate" },
      { "name": "REPORTS", "class_name": "ReportInbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["AbuseGate", "ReportInbox"] }
  ],
  "vars": {
    "TURN_TTL_SECONDS": "3600"
  }
}
