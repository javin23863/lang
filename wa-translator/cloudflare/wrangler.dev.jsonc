// Local-only config for driving the app in a real browser:
//
//   npx wrangler dev -c wrangler.dev.jsonc --port 8788 --local
//   npm --prefix ../mobile run browser
//
// The values under "vars" are placeholders, not credentials. They exist so the
// room signer meets its 32-byte minimum and the dev server will hand out rooms;
// they sign nothing anyone else can reach. Production keeps its real secrets in
// Cloudflare and deploys from wrangler.jsonc, and the "name" here differs so
// this config can never deploy over it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spoken-translation-room-dev",
  "main": "src/account-guard-entry.ts",
  "compatibility_date": "2026-08-13",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "../windows/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "ABUSE",
        "class_name": "AbuseGate"
      },
      {
        "name": "REPORTS",
        "class_name": "ReportInbox"
      },
      {
        "name": "USERS",
        "class_name": "UserDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AbuseGate",
        "ReportInbox"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "UserDirectory"
      ]
    }
  ],
  "vars": {
    "TURN_TTL_SECONDS": "3600",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8788",
    "ROOM_SIGNING_KEY": "local-dev-only-room-signing-key-32-bytes",
    "MODAL_SHARED_SECRET": "local-dev-only-modal-secret",
    "MOBILE_REPORT_ADMIN_TOKEN": "local-dev-only-report-admin-token-32b"
  }
}
